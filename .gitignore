# Python virtual environment - regenerable, machine-specific
.venv/

# Python bytecode cache - auto-generated
__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store

# Secrets - API keys, credentials
.env

# Raw data - too large for Git, downloadable from SEC
data/**
!data/**/
!data/**/.gitkeep
*.duckdb


# dbt build output and logs - regenerated on every run
transform/target/
transform/dbt_packages/
transform/logs/
logs/

transform/.user.yml
